{
  "name": "agenthub-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --config vite.config.js --mode mock",
    "dev:mock": "node ./node_modules/vite/bin/vite.js --config vite.config.js --mode mock",
    "dev:api": "node ./node_modules/vite/bin/vite.js --config vite.config.js --mode api",
    "build": "node ./node_modules/vite/bin/vite.js build --config vite.config.js --mode mock",
    "build:mock": "node ./node_modules/vite/bin/vite.js build --config vite.config.js --mode mock",
    "build:api": "node ./node_modules/vite/bin/vite.js build --config vite.config.js --mode api",
    "preview": "node ./node_modules/vite/bin/vite.js preview --config vite.config.js"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.8.4",
    "echarts": "^5.6.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "less": "^4.2.2",
    "vite": "^6.2.5"
  }
}
